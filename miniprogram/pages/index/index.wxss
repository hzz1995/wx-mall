.home-page {
  padding: 24rpx 24rpx 200rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  padding: 34rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #12382a 0%, #1f4d3b 46%, #496b52 74%, #a9702f 100%);
  box-shadow: 0 18rpx 40rpx rgba(18, 56, 42, 0.2);
}

.hero::before {
  content: '';
  position: absolute;
  right: -130rpx;
  bottom: -150rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(226, 87, 43, 0.5), transparent 68%);
}

.hero::after {
  content: '';
  position: absolute;
  left: -90rpx;
  top: -110rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(217, 164, 65, 0.3), transparent 68%);
}

.hero-watermark {
  position: absolute;
  right: -14rpx;
  top: -16rpx;
  font-size: 108rpx;
  line-height: 0.88;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.07);
  text-align: right;
  pointer-events: none;
  z-index: 0;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-brand {
  min-width: 0;
}

.hero-name {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: #fff9ee;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: rgba(247, 231, 204, 0.68);
}

.shortcuts {
  display: flex;
  gap: 18rpx;
  flex: 0 0 auto;
  padding-top: 2rpx;
}

.shortcut {
  position: relative;
  width: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.72);
}

.shortcut-bubble {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.shortcut-icon {
  width: 36rpx;
  height: 36rpx;
}

.shortcut-badge {
  position: absolute;
  top: -8rpx;
  right: 0;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 15rpx;
  background: linear-gradient(135deg, #f07a3f, #d94a22);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(217, 74, 34, 0.35);
}

.hero-notice {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
  padding: 15rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.notice-tag {
  flex: 0 0 auto;
  padding: 1rpx 10rpx;
  border-radius: 6rpx;
  background: linear-gradient(135deg, #e7b75c, #c8902f);
  color: #3a2a12;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.notice-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.82);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-tags {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.62);
}

.tag-dot {
  color: rgba(255, 255, 255, 0.28);
}

.cat-nav {
  margin: 26rpx 0 4rpx;
  white-space: nowrap;
  display: flex;
}

.cat-nav-item {
  flex: 0 0 auto;
  margin-right: 16rpx;
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.2;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 34rpx 8rpx 20rpx;
}

.section-title {
  position: relative;
  padding-left: 18rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 7rpx;
  bottom: 7rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, var(--accent), var(--gold));
}

.section-sub {
  margin-top: 4rpx;
  padding-left: 18rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.section-more {
  font-size: 23rpx;
  color: var(--accent);
}

.zone {
  margin-top: 34rpx;
}

.zone-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  color: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(35, 36, 31, 0.12);
}

.theme-0 {
  background: linear-gradient(135deg, #0f3a2b, #2f6b52);
}

.theme-1 {
  background: linear-gradient(135deg, #c2471f, #ef8a4b);
}

.theme-2 {
  background: linear-gradient(135deg, #6d3b56, #b05f76);
}

.theme-3 {
  background: linear-gradient(135deg, #2e4a63, #5e7d96);
}

.zone-badge {
  width: 70rpx;
  height: 70rpx;
  flex: 0 0 70rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.zone-info {
  min-width: 0;
  flex: 1;
}

.zone-name {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.zone-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
}

.zone-more {
  flex: 0 0 auto;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.zone-grid {
  margin-top: 20rpx;
}

.product-card {
  box-shadow: 0 10rpx 26rpx rgba(35, 36, 31, 0.06);
}

.product-info {
  padding: 20rpx 22rpx 24rpx;
}

.product-meta .price {
  font-size: 36rpx;
  font-weight: 700;
}

.foot {
  margin-top: 54rpx;
  text-align: center;
}

.foot-line {
  width: 48rpx;
  height: 2rpx;
  background: #d9d5c9;
  margin: 0 auto 22rpx;
}

.foot-title {
  font-size: 23rpx;
  color: var(--ink-soft);
  letter-spacing: 2rpx;
}

.foot-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #b0aea5;
}

.skeleton-card {
  width: 48.6%;
  margin-bottom: 24rpx;
  padding-bottom: 22rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid var(--line);
}

.skeleton-thumb {
  width: 100%;
  height: 330rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 6rpx;
  margin: 20rpx 22rpx 0;
}

.skeleton-line.short {
  width: 45%;
  margin-top: 14rpx;
}

.shimmer {
  background: linear-gradient(90deg, #efede6 25%, #f7f5ef 37%, #efede6 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}

@keyframes shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.empty-panel {
  margin-top: 50rpx;
  padding: 70rpx 32rpx;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
}

.empty-mark {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
  font-size: 42rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--muted);
}
