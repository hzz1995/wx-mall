.shops-page {
  padding: 36rpx 32rpx 80rpx;
}

.head {
  padding: 8rpx 4rpx 26rpx;
}

.head-title {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.add-btn {
  margin-bottom: 24rpx;
  height: 88rpx;
  border-radius: 44rpx;
  border: 1rpx dashed #cbbfa9;
  background: #fffdf8;
  color: var(--green);
  font-size: 29rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-card {
  padding: 10rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
}

.form-title {
  padding: 18rpx 0 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.form-actions .btn {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
}

.address {
  min-height: 90rpx;
  line-height: 1.6;
}

.shop-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--card);
}

.shop-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.shop-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.shop-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 0 0 auto;
}

.shop-tag {
  padding: 3rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 38rpx;
}

.shop-tag.default {
  background: var(--green-soft);
  color: var(--green);
}

.shop-tag.active {
  background: #fbeee8;
  color: var(--accent);
}

.shop-tag.disabled {
  background: #f0eee8;
  color: #a19d90;
}

.shop-fields {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.shop-field {
  display: flex;
  gap: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.shop-field-label {
  flex: 0 0 130rpx;
  color: var(--muted);
}

.shop-field-value {
  flex: 1;
  min-width: 0;
  color: var(--ink-soft);
  word-break: break-all;
}

.shop-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--line);
}

.shop-action {
  padding: 12rpx 26rpx;
  border-radius: 28rpx;
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.4;
}

.shop-action.primary {
  border-color: var(--green);
  color: var(--green);
}

.shop-action.warning {
  border-color: #d9a441;
  color: #9a6b12;
}

.shop-action.danger {
  border-color: #e3c9c1;
  color: var(--accent);
}
