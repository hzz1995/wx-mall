.detail {
  padding: 28rpx 32rpx 80rpx;
}

.success {
  text-align: center;
  padding: 36rpx 0 44rpx;
}

.success-mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: var(--green);
  color: #ffffff;
  font-size: 52rpx;
  line-height: 96rpx;
  text-align: center;
}

.success-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.success-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.status-card {
  background: var(--green);
  color: #ffffff;
  border-radius: 20rpx;
  padding: 34rpx 32rpx;
  margin-bottom: 36rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.status-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.6;
}

.section-title {
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
  margin: 8rpx 8rpx 18rpx;
}

.item-card {
  padding: 8rpx 28rpx;
  margin-bottom: 36rpx;
}

.item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.thumb {
  flex: 0 0 120rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #efede6;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #c3bfb2;
  font-weight: 600;
  background: linear-gradient(150deg, #f2f0e9, #e4e0d5);
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  line-height: 1.4;
}

.item-price {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.item-total {
  font-size: 30rpx;
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 18rpx;
  padding: 26rpx 0;
}

.total-label {
  font-size: 25rpx;
  color: var(--muted);
}

.total-value {
  font-size: 38rpx;
}

.info-card {
  padding: 6rpx 28rpx;
  margin-bottom: 36rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 26rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  flex: 0 0 150rpx;
  color: var(--muted);
}

.info-value {
  flex: 1;
  color: var(--ink);
  word-break: break-all;
}

.mono {
  font-family: 'DIN Alternate', 'Helvetica Neue', monospace;
  letter-spacing: 1rpx;
}

.copy {
  flex: 0 0 auto;
  font-size: 23rpx;
  color: var(--green);
  text-decoration: underline;
  padding-left: 16rpx;
}

.notice {
  background: #fbf3e7;
  border: 1rpx solid #efe0c9;
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
}

.notice-title {
  font-size: 25rpx;
  font-weight: 600;
  color: #7a5a32;
}

.notice-text {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a6b43;
  line-height: 1.7;
}

.notice-text.wechat {
  color: #7a5a32;
  text-decoration: underline;
}

.actions {
  display: flex;
  gap: 22rpx;
  margin-top: 48rpx;
}

.actions .btn {
  flex: 1;
}
