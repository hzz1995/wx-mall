<view class="page detail">
  <view wx:if="{{loading}}" class="state">正在加载…</view>
  <view wx:elif="{{error}}" class="state">
    {{error}}
    <view class="state-action" bindtap="goOrders">返回订单列表</view>
  </view>

  <block wx:elif="{{order}}">
    <view class="success" wx:if="{{created}}">
      <view class="success-mark">✓</view>
      <view class="success-title">下单成功</view>
      <view class="success-sub"></view>
    </view>

    <view class="status-card">
      <view class="status-title">{{order.statusText}}</view>
      <view class="status-sub" wx:if="{{order.status === 'DONE'}}">
        {{isCustomer ? '订单已提交，如需取消可在下方操作' : '订单已完成'}}
      </view>
      <view class="status-sub" wx:elif="{{order.status === 'CLOSED'}}">该订单已结束，无法取消订单</view>
      <view class="status-sub" wx:else>该订单已取消</view>
    </view>

    <view class="section-title">商品</view>
    <view class="card item-card">
      <view class="item" wx:for="{{order.items}}" wx:key="productId">
        <view class="thumb">
          <image wx:if="{{item.image}}" class="thumb-img" src="{{item.image}}" mode="aspectFill" />
          <view wx:else class="thumb-fallback">{{item.initial}}</view>
        </view>
        <view class="item-main">
          <view class="item-name">{{item.name}}</view>
          <view class="item-spec" wx:if="{{item.spec}}">规格型号：{{item.spec}}</view>
          <view class="item-price">¥{{item.priceText}} × {{item.quantity}}</view>
        </view>
        <view class="item-total price"><text class="yen">¥</text>{{item.lineTotalText}}</view>
      </view>
      <view class="total-row">
        <view class="total-label">合计</view>
        <view class="total-value price"><text class="yen">¥</text>{{order.totalText}}</view>
      </view>
    </view>

    <view class="section-title">订单信息</view>
    <view class="card info-card">
      <view class="info-row">
        <view class="info-label">订单号</view>
        <view class="info-value mono">{{order.orderNo}}</view>
        <view class="copy" bindtap="copyOrderNo">复制</view>
      </view>
      <view class="info-row">
        <view class="info-label">下单时间</view>
        <view class="info-value">{{order.createdAtText}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">姓名</view>
        <view class="info-value">{{order.customerName}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">手机号</view>
        <view class="info-value">{{order.phone}}</view>
      </view>
      <view class="info-row" wx:if="{{order.shopName}}">
        <view class="info-label">店铺名称</view>
        <view class="info-value">{{order.shopName}}</view>
      </view>
      <view class="info-row" wx:if="{{order.address}}">
        <view class="info-label">收货地址</view>
        <view class="info-value">{{order.address}}</view>
      </view>
      <view class="info-row" wx:if="{{isStaff}}">
        <view class="info-label">所属销售</view>
        <view class="info-value">{{order.salesName || '—'}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">订单来源</view>
        <view class="info-value">
          {{order.orderSource === 'ASSIST' ? '销售帮下单' : '客户自建'}}
          <text wx:if="{{order.orderSource === 'ASSIST' && order.assistedByName}}">（{{order.assistedByName}}）</text>
        </view>
      </view>
      <view class="info-row">
        <view class="info-label">备注</view>
        <view class="info-value">{{order.remark || '—'}}</view>
      </view>
    </view>

    <button
      wx:if="{{isCustomer && order.status === 'DONE'}}"
      class="btn cancel-order-btn"
      bindtap="cancelOrder"
    >取消订单</button>

    <view class="actions">
      <button class="btn btn-ghost" bindtap="goHome">继续逛逛</button>
      <button class="btn btn-primary" bindtap="goOrders">{{isCustomer ? '查看全部订单' : '返回订单列表'}}</button>
    </view>
  </block>
</view>
