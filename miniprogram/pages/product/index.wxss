.product-page {
  padding-bottom: 200rpx;
}

.videos {
  padding: 0 0 12rpx;
  background: #1c1d19;
}

.product-video {
  width: 100%;
  height: 440rpx;
  display: block;
}

.gallery {
  position: relative;
  width: 100%;
  height: 750rpx;
  background: #efede6;
}

.gallery-swiper,
.gallery-img {
  width: 100%;
  height: 750rpx;
}

.gallery-img {
  display: block;
}

.gallery-count {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(28, 29, 25, 0.52);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.2;
  z-index: 2;
}

.gallery-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 2;
}

.gallery-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
  transition: transform 0.2s ease, background 0.2s ease;
}

.gallery-dot.active {
  background: #ffffff;
  transform: scale(1.3);
}

.gallery-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 180rpx;
  color: #c8c4b7;
  font-weight: 600;
  background: linear-gradient(150deg, #f2f0e9, #e4e0d5);
}

.sheet {
  margin-top: -36rpx;
  position: relative;
  background: var(--bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 36rpx 60rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.price-row .price {
  font-size: 58rpx;
}

.origin {
  font-size: 26rpx;
  color: var(--muted);
  text-decoration: line-through;
}

.off-tag {
  font-size: 22rpx;
  color: var(--muted);
  background: #eceae3;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.price-side {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--muted);
}

.name {
  margin-top: 18rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
}

.meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.dot {
  margin: 0 10rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 36rpx 0;
}

.attrs {
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 4rpx 24rpx 10rpx;
  margin-bottom: 36rpx;
}

.attrs-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  padding: 20rpx 0 10rpx;
}

.attr-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-top: 1rpx dashed var(--line);
  font-size: 25rpx;
}

.attr-label {
  flex: 0 0 150rpx;
  color: var(--muted);
}

.attr-value {
  flex: 1;
  color: var(--ink);
  word-break: break-word;
}

.desc-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--ink);
}

.desc {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--ink-soft);
  white-space: pre-wrap;
  word-break: break-word;
}

.desc-empty {
  color: var(--muted);
}

.product-dock {
  gap: 20rpx;
}

.dock-cart-entry {
  flex: 0 0 92rpx;
  width: 92rpx;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.dock-cart-icon-wrap {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dock-cart-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.dock-cart-badge {
  position: absolute;
  top: -8rpx;
  right: -14rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #f07a3f, #d94a22);
  color: #ffffff;
  font-size: 17rpx;
  line-height: 28rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(217, 74, 34, 0.3);
}

.dock-cart-label {
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--muted);
}

.product-dock-cart {
  flex: 0 0 240rpx;
  height: 80rpx;
  border-radius: 40rpx;
  border: 1rpx solid var(--green);
  background: transparent;
  color: var(--green);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.product-dock-buy {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, var(--accent), var(--accent-deep));
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-shadow: 0 10rpx 24rpx rgba(226, 87, 43, 0.22);
}

.product-dock-disabled {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background: #d8d2c5;
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.product-dock-cart[disabled],
.product-dock-buy[disabled],
.product-dock-disabled[disabled] {
  opacity: 0.55;
}
