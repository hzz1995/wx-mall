.mine-page {
  padding: 36rpx 32rpx 200rpx;
}

.head {
  padding: 8rpx 4rpx 30rpx;
}

.head-title {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  background: var(--green);
  color: #ffffff;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 108rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.type-tag {
  font-size: 20rpx;
  font-weight: 400;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.9);
}

.profile-phone {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.68);
  letter-spacing: 1rpx;
}

.info-card {
  margin-top: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 6rpx 28rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 26rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  flex: 0 0 150rpx;
  color: var(--muted);
}

.info-value {
  flex: 1;
  color: var(--ink);
  word-break: break-all;
}

.menu {
  margin-top: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 4rpx 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 28rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  flex: 1;
}

.menu-extra {
  font-size: 23rpx;
  color: var(--muted);
  margin-right: 10rpx;
}

.menu-arrow {
  color: #b9b6ab;
  font-size: 32rpx;
  line-height: 1;
}

.logout {
  margin-top: 40rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: transparent;
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 28rpx;
}

.guest-card {
  margin-top: 40rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 56rpx 32rpx 48rpx;
  text-align: center;
}

.avatar.guest {
  margin: 0 auto 24rpx;
  background: var(--green);
}

.guest-title {
  font-size: 34rpx;
  font-weight: 600;
}

.guest-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.guest-btn {
  margin-top: 34rpx;
}

.guest-hint {
  margin-top: 20rpx;
  font-size: 21rpx;
  color: #b0aea5;
}

.foot {
  margin-top: 60rpx;
  text-align: center;
  font-size: 21rpx;
  color: #b0aea5;
  letter-spacing: 1rpx;
}
