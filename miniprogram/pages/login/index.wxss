.login {
  min-height: 100vh;
  padding: 96rpx 56rpx 60rpx;
  display: flex;
  flex-direction: column;
}

.brand {
  text-align: center;
  margin-bottom: 64rpx;
}

.brand-mark {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  background: var(--green);
  color: #f6f4ef;
  font-size: 52rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-name {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.brand-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.form-card {
  padding: 4rpx 32rpx;
}

.eye {
  flex: 0 0 auto;
  font-size: 23rpx;
  color: var(--muted);
  padding: 4rpx 0 4rpx 20rpx;
}

.login-btn {
  margin-top: 40rpx;
}

.hint {
  margin-top: 30rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--muted);
}

.foot {
  margin-top: auto;
  padding-top: 60rpx;
  text-align: center;
  font-size: 21rpx;
  color: #b0aea5;
  letter-spacing: 1rpx;
}
