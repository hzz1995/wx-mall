.cart-page {
  padding: 36rpx 32rpx calc(300rpx + env(safe-area-inset-bottom));
}

.head {
  padding: 8rpx 4rpx 26rpx;
}

.head-title {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.shop-bar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-bottom: 20rpx;
}

.shop-picker {
  display: inline-block;
  max-width: 560rpx;
}

.shop-pill {
  display: inline-flex;
  align-items: center;
  max-width: 560rpx;
  box-sizing: border-box;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
  font-size: 23rpx;
  line-height: 1.4;
}

.shop-pill-label,
.shop-pill-arrow {
  flex: 0 0 auto;
}

.shop-pill-name {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.shop-pill-arrow {
  padding-left: 8rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 20rpx;
}

.check-hit {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check {
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #c9c6bb;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}

.check.checked {
  background: var(--green);
  border-color: var(--green);
}

.check.disabled {
  background: #efede6;
  border-color: #e0ddd4;
  opacity: 0.6;
}

.check-mark {
  font-size: 24rpx;
  line-height: 1;
}

.cart-item .thumb {
  flex: 0 0 150rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.cart-item .thumb-fallback {
  font-size: 56rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-top {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-remove {
  flex: 0 0 auto;
  align-self: flex-start;
  margin-top: -8rpx;
  margin-right: -8rpx;
  padding: 0 0 8rpx 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  color: var(--muted);
  text-decoration: underline;
}

.item-attrs {
  margin-top: 6rpx;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--muted);
}

.off-sale {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--accent);
}

.item-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 18rpx;
}

.item-price {
  font-size: 32rpx;
}

.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 54rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background: #faf9f5;
}

.stepper-btn.disabled {
  color: #c9c7bd;
}

.stepper-input {
  width: 76rpx;
  height: 48rpx;
  min-height: 48rpx;
  padding: 0;
  box-sizing: border-box;
  text-align: center;
  font-size: 26rpx;
  line-height: 48rpx;
  border-left: 1rpx solid var(--line);
  border-right: 1rpx solid var(--line);
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(108rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
  background: rgba(251, 250, 246, 0.97);
  border-top: 1rpx solid var(--line);
  padding: 18rpx 24rpx 20rpx;
}

.dock-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 0 0 auto;
  padding-right: 2rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
}

.batch-remove {
  flex: 0 0 auto;
  padding: 8rpx 10rpx;
  font-size: 24rpx;
  line-height: 1.3;
  color: var(--accent);
  text-decoration: underline;
}

.batch-remove.disabled {
  color: #c9c7bd;
  text-decoration: none;
}

.select-all .check {
  flex: 0 0 36rpx;
  width: 36rpx;
  height: 36rpx;
}

.dock-main {
  flex: 1;
  min-width: 0;
}

.dock-label {
  font-size: 21rpx;
  line-height: 1.3;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dock-total {
  font-size: 38rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.dock .dock-btn {
  flex: 0 0 190rpx;
  width: 190rpx;
  height: 80rpx;
  margin: 0;
  border-radius: 40rpx;
}

.state-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b0aea5;
}

.state-btn {
  margin: 36rpx auto 0;
  width: 260rpx;
}

.no-shop-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 140rpx 48rpx 0;
}

.no-shop-state .state-btn {
  width: 300rpx;
}

.no-shop-state .state-btn .btn {
  width: 100%;
}

.role-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 120rpx 48rpx 0;
}

.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 160rpx 48rpx;
}

.role-mark,
.empty-cart-mark {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  color: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}

.role-title,
.empty-cart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.role-sub,
.empty-cart-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.6;
}

.empty-cart-btn {
  margin-top: 40rpx;
  width: 260rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, var(--accent), var(--accent-deep));
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-shadow: 0 10rpx 24rpx rgba(226, 87, 43, 0.22);
}

.empty-cart-btn::after {
  border: none;
}
