<view class="page profile-page">
  <view class="head">
    <view class="head-title">个人资料</view>
    <view class="head-sub">手机号由店主维护，如需修改请联系店主</view>
  </view>

  <view class="card form-card">
    <view class="field">
      <view class="field-label">手机号</view>
      <view class="readonly">{{phone}}</view>
    </view>
    <view class="field">
      <view class="field-label required">姓名</view>
      <input
        class="field-input"
        maxlength="20"
        placeholder="请输入姓名"
        placeholder-class="field-placeholder"
        value="{{name}}"
        bindinput="onNameInput"
      />
    </view>
    <view class="field" wx:if="{{isCustomer}}" bindtap="goShops">
      <view class="field-label">店铺管理</view>
      <view class="readonly">已维护 {{shopCount}} 个店铺</view>
      <view class="profile-link">管理 ›</view>
    </view>
    <view class="field" wx:if="{{!isCustomer}}">
      <view class="field-label">账号说明</view>
      <view class="readonly">销售/管理员账号无需维护店铺与收货地址</view>
    </view>
    <view class="field" wx:if="{{salesName}}">
      <view class="field-label">负责销售</view>
      <view class="readonly">{{salesName}}</view>
    </view>
  </view>

  <button class="btn btn-primary save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存资料</button>
</view>
