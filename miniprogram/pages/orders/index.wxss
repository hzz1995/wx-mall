.orders {
  padding: 28rpx 32rpx 80rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx 28rpx;
}

.head-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.export-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--green);
  color: var(--green);
  font-size: 21rpx;
  line-height: 1.4;
}

.export-btn.disabled {
  opacity: 0.45;
}

.order-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 26rpx 26rpx 22rpx;
  margin-bottom: 24rpx;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.order-no {
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.order-top-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.order-check {
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-check.checked {
  background: var(--green);
  border-color: var(--green);
}

.order-check-mark {
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
}

.order-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.source-tag {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--green-soft);
  color: var(--green);
  font-size: 18rpx;
  line-height: 1.5;
}

.source-tag.assist {
  background: #fbeee8;
  color: var(--accent);
}

.order-body {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.thumb {
  flex: 0 0 130rpx;
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #efede6;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #c3bfb2;
  font-weight: 600;
  background: linear-gradient(150deg, #f2f0e9, #e4e0d5);
}

.order-main {
  flex: 1;
  min-width: 0;
}

.order-name {
  font-size: 28rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-qty {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.order-amount {
  font-size: 32rpx;
  flex: 0 0 auto;
}

.order-remark {
  margin-top: 14rpx;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  background: #faf7f0;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ink-soft);
  word-break: break-word;
}

.order-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--line);
}

.order-time {
  font-size: 22rpx;
  color: var(--muted);
}

.order-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.reorder-btn {
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--accent);
  color: var(--accent);
  font-size: 21rpx;
  line-height: 1.4;
}

.order-more {
  font-size: 23rpx;
  color: var(--green);
}

.load-more {
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  padding: 20rpx 0 10rpx;
}

.state-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b0aea5;
}

.state-btn {
  margin: 36rpx auto 0;
  width: 280rpx;
}

.staff-filters {
  margin-bottom: 22rpx;
}

.picker-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.select-pill {
  display: inline-flex;
  max-width: 100%;
  box-sizing: border-box;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.range-scroll {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.range-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 1.4;
}

.range-chip.active {
  background: var(--green);
  border-color: var(--green);
  color: #fff;
}

.month-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.month-label {
  font-size: 22rpx;
  color: var(--muted);
}

.month-pill {
  display: inline-flex;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 1.4;
}

.month-pill.active {
  background: var(--green);
  border-color: var(--green);
  color: #fff;
}

.order-customer {
  margin: 0 0 14rpx;
  font-size: 22rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}

.order-sales {
  margin: 0 0 12rpx;
  font-size: 22rpx;
  color: var(--muted);
}
