.orders {
  padding: 28rpx 32rpx 80rpx;
}

.head {
  padding: 20rpx 4rpx 28rpx;
}

.head-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.order-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 26rpx 26rpx 22rpx;
  margin-bottom: 24rpx;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.order-no {
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.order-body {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.thumb {
  flex: 0 0 130rpx;
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #efede6;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #c3bfb2;
  font-weight: 600;
  background: linear-gradient(150deg, #f2f0e9, #e4e0d5);
}

.order-main {
  flex: 1;
  min-width: 0;
}

.order-name {
  font-size: 28rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-qty {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.order-amount {
  font-size: 32rpx;
  flex: 0 0 auto;
}

.order-remark {
  margin-top: 14rpx;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  background: #faf7f0;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ink-soft);
  word-break: break-word;
}

.order-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--line);
}

.order-time {
  font-size: 22rpx;
  color: var(--muted);
}

.order-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.reorder-btn {
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--accent);
  color: var(--accent);
  font-size: 21rpx;
  line-height: 1.4;
}

.order-more {
  font-size: 23rpx;
  color: var(--green);
}

.load-more {
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  padding: 20rpx 0 10rpx;
}

.state-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b0aea5;
}

.state-btn {
  margin: 36rpx auto 0;
  width: 280rpx;
}
