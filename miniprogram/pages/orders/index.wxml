<view class="page orders">
  <view class="head">
    <view class="head-title">{{mineMode || isCustomer ? '我的订单' : '客户订单'}}</view>
    <view
      wx:if="{{isStaff && !mineMode}}"
      class="export-btn {{selectedCount ? '' : 'disabled'}}"
      bindtap="exportOrders"
    >{{exporting ? '导出中…' : '导出 Excel' + (selectedCount ? '（' + selectedCount + '）' : '')}}</view>
  </view>

  <view class="staff-filters" wx:if="{{isStaff && !mineMode}}">
    <view class="picker-row">
      <picker mode="selector" range="{{customerNames}}" value="{{customerIndex}}" bindchange="onCustomerChange">
        <view class="select-pill">客户：{{customerNames[customerIndex]}} ▾</view>
      </picker>
      <picker
        wx:if="{{isAdmin}}"
        mode="selector"
        range="{{salesNames}}"
        value="{{salesIndex}}"
        bindchange="onSalesChange"
      >
        <view class="select-pill">销售：{{salesNames[salesIndex]}} ▾</view>
      </picker>
    </view>

    <scroll-view class="range-scroll" scroll-x enable-flex>
      <view
        wx:for="{{rangeOptions}}"
        wx:key="value"
        class="range-chip {{rangeType === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="selectRange"
      >{{item.label}}</view>
    </scroll-view>

    <view class="month-row">
      <view class="month-label">按月份</view>
      <picker
        mode="date"
        fields="month"
        value="{{monthValue}}"
        start="{{monthStart}}"
        end="{{monthEnd}}"
        bindchange="onMonthChange"
      >
        <view class="month-pill {{rangeType === 'month' ? 'active' : ''}}">{{monthValue}} ▾</view>
      </picker>
    </view>
  </view>

  <view class="list" wx:if="{{list.length}}">
    <view
      class="order-card"
      wx:for="{{list}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goDetail"
    >
      <view class="order-top">
        <view class="order-top-left">
          <view
            wx:if="{{isStaff && !mineMode}}"
            class="order-check {{item.selected ? 'checked' : ''}}"
            data-id="{{item._id}}"
            catchtap="toggleOrderSelect"
          >
            <view wx:if="{{item.selected}}" class="order-check-mark">✓</view>
          </view>
          <view class="order-no">{{item.orderNo}}</view>
        </view>
        <view class="order-tags">
          <view class="source-tag {{item.orderSource === 'ASSIST' ? 'assist' : ''}}">
            {{item.orderSource === 'ASSIST' ? '销售帮下单' : '客户自建'}}
          </view>
          <view class="tag {{item.statusClass}}">{{item.statusText}}</view>
        </view>
      </view>

      <view class="order-customer" wx:if="{{isStaff && !mineMode}}">
        <text>{{item.customerName || '未填写'}}</text>
        <text wx:if="{{item.shopName}}"> · {{item.shopName}}</text>
        <text wx:if="{{item.phone}}"> · {{item.phone}}</text>
      </view>
      <view class="order-sales" wx:if="{{isAdmin && !mineMode}}">所属销售：{{item.salesName || '—'}}</view>

      <view class="order-body">
        <view class="thumb">
          <image wx:if="{{item.itemImage}}" class="thumb-img" src="{{item.itemImage}}" mode="aspectFill" />
          <view wx:else class="thumb-fallback">{{item.itemInitial}}</view>
        </view>
        <view class="order-main">
          <view class="order-name">{{item.itemName}}{{item.extraCount > 0 ? ' 等 ' + (item.extraCount + 1) + ' 种商品' : ''}}</view>
          <view class="order-qty">× {{item.itemQuantity}}</view>
        </view>
        <view class="order-amount price"><text class="yen">¥</text>{{item.totalText}}</view>
      </view>
      <view class="order-remark" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
      <view class="order-bottom">
        <view class="order-time">{{item.createdAtText}}</view>
        <view class="order-actions">
          <view
            wx:if="{{isCustomer && item.status === 'DONE'}}"
            class="cancel-btn"
            data-id="{{item._id}}"
            catchtap="cancelOrder"
          >取消订单</view>
          <view wx:if="{{isCustomer}}" class="reorder-btn" data-index="{{index}}" catchtap="reorder">再来一单</view>
          <view class="order-more">详情 ›</view>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{loadingMore}}">正在加载…</view>
    <view class="load-more" wx:elif="{{!hasMore}}">没有更多订单了</view>
  </view>

  <view wx:elif="{{loading}}" class="state">正在加载…</view>
  <view wx:elif="{{error}}" class="state">
    {{error}}
    <view class="state-action" bindtap="load">重新加载</view>
  </view>
  <view wx:else class="state">
    {{mineMode || isCustomer ? '还没有订单' : '暂无符合条件的订单'}}
    <view class="state-hint" wx:if="{{isCustomer}}">去挑几件喜欢的商品吧</view>
    <view class="state-hint" wx:if="{{mineMode}}">加购商品后即可体验下单流程</view>
    <view class="state-hint" wx:if="{{!isCustomer && !mineMode}}">可以换个时间范围或客户</view>
    <view class="state-btn" wx:if="{{isCustomer || mineMode}}">
      <button class="btn btn-primary" bindtap="goShopping">去逛逛</button>
    </view>
  </view>
</view>
