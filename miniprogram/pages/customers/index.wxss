.customers-page {
  padding: 28rpx 32rpx 80rpx;
}

.head {
  padding: 16rpx 4rpx 24rpx;
}

.head-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 76rpx;
  padding: 0 22rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.55;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
}

.search-placeholder {
  color: var(--muted);
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f1eee6;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 38rpx;
  text-align: center;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin: 18rpx 0;
  overflow-x: auto;
}

.filter-chip {
  flex: 0 0 auto;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 1.4;
}

.filter-chip.active {
  background: var(--green);
  border-color: var(--green);
  color: #fff;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.summary-card {
  padding: 18rpx 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
}

.summary-card.wide {
  grid-column: 1 / -1;
}

.summary-label {
  font-size: 21rpx;
  color: var(--muted);
}

.summary-value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.summary-value.amount {
  color: var(--accent);
}

.customer-card {
  padding: 22rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
}

.customer-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.customer-main {
  flex: 1;
  min-width: 0;
}

.customer-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.status {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 400;
}

.status.on {
  background: var(--green-soft);
  color: var(--green);
}

.status.off {
  background: #f2efe8;
  color: var(--muted);
}

.customer-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.assist-btn {
  flex: 0 0 auto;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--green);
  color: #fff;
  font-size: 22rpx;
  line-height: 1.2;
}

.assist-btn.disabled {
  background: #f2efe8;
  color: var(--muted);
}

.customer-address {
  margin-top: 14rpx;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  background: #faf7f0;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--ink-soft);
  word-break: break-all;
}

.stat-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.stat-item {
  flex: 1;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #f8f6f0;
}

.stat-label {
  font-size: 20rpx;
  color: var(--muted);
}

.stat-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.stat-value.amount {
  color: var(--accent);
}

.change-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.change {
  font-weight: 600;
  color: var(--muted);
}

.change.up {
  color: #2e7d5b;
}

.change.down {
  color: #c9502d;
}

.sales-row {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.truncated {
  padding: 10rpx 0;
  text-align: center;
  font-size: 21rpx;
  color: var(--muted);
}

.state {
  padding: 100rpx 20rpx;
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
}

.state-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b0aea5;
}

.state-action {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--green);
  text-decoration: underline;
}
