<view class="tabbar" wx:if="{{!hidden}}">
  <view class="tabbar-inner">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="icon-wrap {{selected === index ? 'active' : ''}}">
        <image class="tab-icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
        <view class="badge" wx:if="{{index === 1 && cartCount > 0}}">{{cartCount > 99 ? '99+' : cartCount}}</view>
      </view>
      <text class="tab-label {{selected === index ? 'active' : ''}}">{{item.text}}</text>
    </view>
  </view>
</view>
