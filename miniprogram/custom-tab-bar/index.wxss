.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(255, 253, 248, 0.97);
  border-top: 1rpx solid #e9dfce;
  box-shadow: 0 -12rpx 32rpx rgba(35, 36, 31, 0.07);
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar-inner {
  display: flex;
  height: 108rpx;
  align-items: center;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
}

.icon-wrap {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
}

.icon-wrap.active {
  background: #fce8de;
}

.tab-icon {
  width: 38rpx;
  height: 38rpx;
}

.tab-label {
  font-size: 20rpx;
  line-height: 1.2;
  color: #8e897c;
}

.tab-label.active {
  color: #e2572b;
  font-weight: 600;
}

.badge {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #f07a3f, #d94a22);
  color: #ffffff;
  font-size: 17rpx;
  line-height: 28rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(217, 74, 34, 0.3);
}
