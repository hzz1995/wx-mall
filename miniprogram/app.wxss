page {
  --bg: #f8f2e7;
  --card: #fffdf8;
  --ink: #23241f;
  --ink-soft: #55564e;
  --muted: #8e897c;
  --line: #e9dfce;
  --green: #1f4d3b;
  --green-deep: #12382a;
  --green-soft: #e9f1eb;
  --accent: #e2572b;
  --accent-deep: #c6431f;
  --gold: #d9a441;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.card {
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
}

.price {
  color: var(--accent);
  font-weight: 600;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.price .yen {
  font-size: 0.72em;
  margin-right: 2rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent-deep));
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(226, 87, 43, 0.22);
}

.btn-primary[disabled] {
  background: #c9c3b6;
  box-shadow: none;
  color: #f7f3ea;
}

.btn-ghost {
  background: transparent;
  color: var(--green);
  border: 1rpx solid var(--green);
}

.btn[disabled] {
  opacity: 0.55;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 34rpx;
}

.tag-done {
  color: var(--green);
  background: var(--green-soft);
}

.tag-cancel {
  color: var(--muted);
  background: #f0efeb;
}

.state {
  padding: 160rpx 48rpx;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

.state-action {
  margin-top: 20rpx;
  color: var(--green);
  font-size: 26rpx;
  text-decoration: underline;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  background: rgba(251, 250, 246, 0.96);
  border-top: 1rpx solid var(--line);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.dock-main {
  flex: 1;
}

.dock .btn {
  flex: 0 0 300rpx;
}

.field {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  width: 150rpx;
  flex: 0 0 150rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
  padding-top: 4rpx;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  min-height: 48rpx;
}

.field-placeholder {
  color: #b7b5ac;
}

.required::after {
  content: ' *';
  color: var(--accent);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  position: relative;
  width: 48.6%;
  margin-bottom: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
}

.product-card::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 5rpx;
  background: linear-gradient(90deg, var(--accent), var(--gold));
  z-index: 2;
}

.thumb {
  width: 100%;
  height: 330rpx;
  background: #efede6;
  position: relative;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 88rpx;
  color: #c3bfb2;
  font-weight: 600;
  background: linear-gradient(150deg, #f2f0e9, #e7e4da);
}

.video-tag {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--accent), var(--accent-deep));
  color: #ffffff;
  font-size: 20rpx;
}

.product-info {
  padding: 20rpx 22rpx 24rpx;
}

.product-name {
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 78rpx;
}

.product-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 14rpx;
}

.product-meta .price {
  font-size: 34rpx;
}

.sales {
  font-size: 22rpx;
  color: var(--muted);
}

